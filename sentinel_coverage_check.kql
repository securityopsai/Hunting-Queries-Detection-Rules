];

// --- what is actually emitting telemetry, normalized to short name ---
let seen = union isfuzzy=true
    (Heartbeat
        | where TimeGenerated > ago(lookback)
        | extend Computer = tolower(tostring(split(Computer, ".")[0]))
        | distinct Computer, Feed = "Heartbeat"),
    (Syslog
        | where TimeGenerated > ago(lookback)
        | extend Computer = tolower(tostring(split(Computer, ".")[0]))
        | distinct Computer, Feed = "Syslog"),
    (CommonSecurityLog
        | where TimeGenerated > ago(lookback)
        | extend RawName = coalesce(DeviceName, SourceHostName, Computer)
        | extend Computer = tolower(tostring(split(RawName, ".")[0]))
        | where isnotempty(Computer)
        | distinct Computer, Feed = "CommonSecurityLog"),
    (DeviceInfo
        | where TimeGenerated > ago(lookback)
        | extend Computer = tolower(tostring(split(DeviceName, ".")[0]))
        | distinct Computer, Feed = "DeviceInfo");

let seenAgg = seen
    | summarize Feeds = strcat_array(make_set(Feed), ", ") by Computer;

// --- per-device result: PRESENT/MISSING + which feed(s) --------------
expected
| join kind=leftouter seenAgg on Computer
| extend Status = iff(isempty(Feeds), "MISSING", "PRESENT")
| project Computer, Status, Feeds
| sort by Status asc, Computer asc

